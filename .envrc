use flake

if [ -z "${CARGO_TARGET_DIR:-}" ]; then
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  git_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf worktree)"
  safe_branch="$(printf '%s' "${git_branch:-worktree}" | tr -cs 'A-Za-z0-9_.-' '_')"
  if [ -n "$git_common_dir" ]; then
    # Build output belongs to the machine that built it, on its own disk: the
    # clone may be a share seen from both sides of a VM boundary, where every
    # write is a round trip, darwin and linux artifacts would mix, and cargo's
    # lock on the directory is not honoured across the share. Keyed by clone
    # and branch as before, under this machine's cache.
    safe_clone="$(printf '%s' "$git_common_dir" | tr -cs 'A-Za-z0-9_.-' '_')"
    export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cargo-target/$safe_clone/$safe_branch"
  fi
fi
